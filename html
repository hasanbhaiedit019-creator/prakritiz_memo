<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Prakritiz - Memo</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --green:#2E9E3F;       /* Prakritiz green */
    --green-dark:#14451d;  /* header/footer dark green */
    --orange:#F47C20;      /* Prakritiz orange */
    --ink:#1b1b1b;
    --line:#2b2b2b;
    --paper:#ffffff;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'Poppins',Arial,sans-serif;background:#e9ecea;color:var(--ink);padding:24px 12px;font-size:13px}
  .toolbar{max-width:794px;margin:0 auto 14px;text-align:right}
  .toolbar button{background:var(--orange);color:#fff;border:0;padding:10px 18px;border-radius:6px;font:600 13px 'Poppins',sans-serif;cursor:pointer}
  .toolbar button:focus-visible{outline:3px solid var(--green);outline-offset:2px}

  .page{max-width:794px;min-height:1123px;margin:0 auto;background:var(--paper);display:flex;flex-direction:column;box-shadow:0 4px 24px rgba(0,0,0,.12)}

  header{background:var(--green-dark);border-bottom:6px solid var(--orange);padding:26px 36px;display:flex;justify-content:space-between;align-items:center}
  header h1{font-family:'Playfair Display',serif;color:#fff;font-size:38px;font-weight:700}
  .logo-box{background:#fff;border-radius:8px;padding:4px 10px;display:flex;align-items:center;height:64px}
  .logo-box img{height:56px;width:auto;display:block}
  .logo-fallback{font:700 20px 'Poppins',sans-serif;color:var(--orange)}

  main{padding:28px 36px;flex:1;display:flex;flex-direction:column}
  .top{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding-bottom:16px;border-bottom:1.5px solid var(--line)}
  .bill h3{font-size:15px;font-weight:600;margin-bottom:6px;color:var(--green)}
  .bill p{line-height:1.6}
  .meta{min-width:200px}
  .meta div{display:flex;justify-content:space-between;gap:20px;margin-bottom:4px}
  .meta b{font-weight:600}

  .table-wrap{overflow-x:auto;margin-top:20px}
  table{width:100%;border-collapse:collapse;border:1.5px solid var(--line);min-width:520px}
  th,td{padding:10px 12px;text-align:center}
  th{border-bottom:1.5px solid var(--line);font-weight:600;background:#f4faf5;color:var(--green-dark)}
  th+th,td+td{border-left:1.5px solid var(--line)}
  td.name,th.name{text-align:left}
  tbody td{height:40px}
  tbody tr.filler td{height:34px}

  .totals-row{display:flex;justify-content:flex-end;margin-top:-1.5px}
  .totals{width:260px;border:1.5px solid var(--line)}
  .totals div{display:flex;justify-content:space-between;padding:8px 14px}
  .totals .due{border-top:1.5px solid var(--line);background:var(--orange);color:#fff;font-weight:600;font-size:15px}

  .lower{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-top:24px}
  .lower h4{font-size:14px;font-weight:600;color:var(--green);margin-bottom:6px}
  .lower p{line-height:1.7}
  .sign{align-self:flex-end;text-align:center;min-width:180px}
  .sign span{display:block;border-top:1.5px solid var(--line);padding-top:6px}

  footer{background:var(--green-dark);border-top:6px solid var(--orange);color:#fff;padding:16px 36px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:12px}

  @media print{
    body{background:#fff;padding:0}
    .toolbar{display:none}
    .page{box-shadow:none;max-width:none;min-height:100vh}
    *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  }
  @media (max-width:560px){
    header h1{font-size:28px}
    main,header,footer{padding-left:18px;padding-right:18px}
  }
</style>
</head>
<body>

<div class="toolbar"><button onclick="window.print()">Print / Save as PDF</button></div>

<div class="page">
  <header>
    <h1>Memo</h1>
    <div class="logo-box">
      <!-- Logo: GitHub repo te "image" folder baniye oikhane logo.png nam e upload korun -->
      <img src="image/logo.png" alt="Prakritiz" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'logo-fallback',textContent:'PRAKRITIZ'}))">
    </div>
  </header>

  <main>
    <div class="top">
      <div class="bill">
        <h3>Bill to</h3>
        <p id="c-name"></p>
        <p id="c-address"></p>
        <p id="c-phone"></p>
      </div>
      <div class="meta">
        <div><span>Memo No</span><b id="m-no"></b></div>
        <div><span>Date</span><b id="m-date"></b></div>
      </div>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr><th style="width:56px">No.</th><th class="name">Product Name</th><th style="width:110px">Price</th><th style="width:80px">Qty.</th><th style="width:120px">Total</th></tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
    </div>

    <div class="totals-row">
      <div class="totals">
        <div><span>Subtotal</span><span id="t-sub"></span></div>
        <div><span>Delivery</span><span id="t-del"></span></div>
        <div class="due"><span>Amount Due</span><span id="t-due"></span></div>
      </div>
    </div>

    <div class="lower">
      <div>
        <h4>Payment Info</h4>
        <p id="pay-info"></p>
        <h4 style="margin-top:14px">Terms &amp; Condition</h4>
        <p id="terms" style="max-width:340px"></p>
      </div>
      <div class="sign"><span>Authorised Sign</span></div>
    </div>
  </main>

  <footer>
    <span id="f-phone"></span>
    <span id="f-web"></span>
    <span id="f-addr"></span>
  </footer>
</div>

<script>
/* =====================================================================
   ✏️  EDIT KORAR JAYGA  (shudhu ei SETTINGS ongsho ta change korben)
   ===================================================================== */

const SETTINGS = {

  /* 1) AMADER PAGE / SHOP ER NUMBER & TOTHYO (footer e dekhabe)
        👉 Nicher "01XXXXXXXXX" muche apnar number boshan */
  shopPhone:   "01XXXXXXXXX",
  shopWebsite: "facebook.com/prakritiz",   // page link / website
  shopAddress: "Khulna, Bangladesh",       // dokaner thikana

  /* 2) CUSTOMER ER TOTHYO (prottek memo te change korben) */
  customerName:    "Customer Name",
  customerAddress: "Customer Address",
  customerPhone:   "01XXXXXXXXX",

  /* 3) MEMO NUMBER & DATE */
  memoNo: "001",
  date:   "13/10/2026",

  /* 4) PRODUCT LIST
        Prottek product ek line e: { name:"Product er nam", price: dam, qty: poriman }
        Notun product add korte ek ta line copy kore niche paste korun.
        Total automatic hisab hobe, nijer hate likhte hobe na. */
  items: [
    { name: "Product 1", price: 250, qty: 2 },
    { name: "Product 2", price: 120, qty: 3 },
    { name: "Product 3", price: 500, qty: 1 }
  ],

  /* 5) DELIVERY CHARGE (na thakle 0 likhun) */
  delivery: 60,

  /* 6) PAYMENT INFO (bKash / Nagad / Bank) */
  payment: "bKash / Nagad: 01XXXXXXXXX (Personal)",

  /* 7) TERMS & CONDITION */
  terms: "Product delivery howar por return/exchange er jonno 3 diner moddhe jogajog korun.",

  currency: "৳"
};

/* ===================== Er niche kichu change korar dorkar nei ===================== */
const $ = id => document.getElementById(id);
const S = SETTINGS, cur = S.currency;
const money = n => cur + Number(n).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});

$('c-name').textContent = S.customerName;
$('c-address').textContent = S.customerAddress;
$('c-phone').textContent = S.customerPhone;
$('m-no').textContent = S.memoNo;
$('m-date').textContent = S.date;
$('pay-info').textContent = S.payment;
$('terms').textContent = S.terms;
$('f-phone').textContent = S.shopPhone;
$('f-web').textContent = S.shopWebsite;
$('f-addr').textContent = S.shopAddress;

let sub = 0;
const tbody = $('rows');
S.items.forEach((it, i) => {
  const total = it.price * it.qty;
  sub += total;
  const tr = document.createElement('tr');
  [String(i+1).padStart(2,'0'), it.name, money(it.price), it.qty, money(total)].forEach((v, c) => {
    const td = document.createElement('td');
    td.textContent = v;
    if (c === 1) td.className = 'name';
    tr.appendChild(td);
  });
  tbody.appendChild(tr);
});
/* khali row gulo table ke design er moto lomba rakhe */
for (let i = S.items.length; i < 8; i++) {
  const tr = document.createElement('tr');
  tr.className = 'filler';
  tr.innerHTML = '<td></td><td></td><td></td><td></td><td></td>';
  tbody.appendChild(tr);
}

$('t-sub').textContent = money(sub);
$('t-del').textContent = money(S.delivery);
$('t-due').textContent = money(sub + S.delivery);
</script>
</body>
</html>
